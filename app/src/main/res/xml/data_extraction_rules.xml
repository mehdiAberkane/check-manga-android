<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 et plus : sauvegarde Google et transfert vers un nouveau téléphone.
  Seule la collection est sauvegardée. Une règle « include » exclut tout le reste :
  fichiers temporaires (*.tmp), fichier illisible mis de côté (series.json.corrupt),
  cache des sorties (releases.json, reconstruit à la prochaine vérification),
  base de WorkManager (tâches reprogrammées au lancement) et cache.
  Garder en phase avec backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="series.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="series.json" />
    </device-transfer>
</data-extraction-rules>
